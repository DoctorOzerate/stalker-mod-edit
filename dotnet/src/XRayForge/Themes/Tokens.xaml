<?xml version="1.0" encoding="utf-8"?>
<!--
  Базовые токены темы «Steel + Phosphor» (референс screenshots/work.png).
  Значения из docs/ui-references/tokens/00-palette.tokens.md.
  Ключи совпадают с ThemeTokens.Keys (XRayForge.Core.Ui) — ThemeService
  перезаписывает эти ресурсы AtRunTime при смене акцента/плотности.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Поверхности -->
    <SolidColorBrush x:Key="SurfaceBase" Color="#101010" />
    <SolidColorBrush x:Key="SurfacePanel" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#303030" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#0B0B0B" />
    <SolidColorBrush x:Key="SurfaceDisplay" Color="#0A1A0E" />

    <!-- Рамки (гравированная фаска) -->
    <SolidColorBrush x:Key="BorderBevel" Color="#404040" />
    <SolidColorBrush x:Key="BorderStrong" Color="#5A5A5A" />

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimary" Color="#C8C8C8" />
    <SolidColorBrush x:Key="TextMuted" Color="#7A7A7A" />
    <SolidColorBrush x:Key="TextInverted" Color="#0A0A0A" />
    <SolidColorBrush x:Key="TextAccent" Color="#39FF14" />

    <!-- Акцент -->
    <SolidColorBrush x:Key="AccentMain" Color="#2FE06A" />
    <SolidColorBrush x:Key="AccentHover" Color="#25B455" />
    <SolidColorBrush x:Key="AccentGlow" Color="#39FF14" />
    <SolidColorBrush x:Key="AccentDim" Color="#1E5B32" />
    <SolidColorBrush x:Key="Accent" Color="#2FE06A" />

    <!-- Состояния -->
    <SolidColorBrush x:Key="StateWarn" Color="#FFB020" />
    <SolidColorBrush x:Key="StateDanger" Color="#E03A3A" />
    <SolidColorBrush x:Key="StateOk" Color="#2FE06A" />

    <!-- Служебные цвета хрома (металл, сетка, затемнение оверлеев) -->
    <SolidColorBrush x:Key="ChromeBackdrop" Color="#202020" />
    <SolidColorBrush x:Key="GridLine" Color="#27272A" />
    <SolidColorBrush x:Key="Scrim" Color="#C0000000" />

    <!-- Метрики плотности (normal); ThemeService меняет их вместе с темой -->
    <sys:Double x:Key="DensityRowHeight">30</sys:Double>
    <sys:Double x:Key="DensityPanelGap">10</sys:Double>
    <sys:Double x:Key="DensityPanelPadding">14</sys:Double>
    <sys:Double x:Key="DensityControlPaddingX">12</sys:Double>
    <sys:Double x:Key="DensityControlPaddingY">5</sys:Double>
    <sys:Double x:Key="DensityFontSize">13</sys:Double>
    <sys:Double x:Key="DensitySmallFontSize">11</sys:Double>
    <sys:Double x:Key="DensityTitleFontSize">12</sys:Double>
    <sys:Double x:Key="DensityRadius">6</sys:Double>
</ResourceDictionary>
