<Window x:Class="XRayForge.Views.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:XRayForge.Localization"
        Title="{loc:Loc projectSettingsTitle}"
        Width="760" Height="520" MinWidth="620" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderBevel}"
                    BorderThickness="0,0,0,1" Padding="12,6" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc projectSettingsTitle}" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{loc:Loc overviewSub}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" IsCancel="True" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Имя, серия, gamedata -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc projectName}" Style="{StaticResource CaptionText}" />
                        <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" />

                        <TextBlock Text="{loc:Loc series}" Style="{StaticResource CaptionText}" />
                        <ListBox ItemsSource="{Binding Series}" SelectedItem="{Binding SelectedSeries}"
                                 MaxHeight="108" Margin="0,4,0,14">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ConfigDirectory}"
                                                   Style="{StaticResource CaptionText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{loc:Loc gamedataPath}" Style="{StaticResource CaptionText}" />
                        <TextBox Text="{Binding GamedataPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc chooseFolder}" Command="{Binding ChooseFolderCommand}" Margin="0,0,6,0" />
                            <Button Content="{loc:Loc scanGamedata}" Style="{StaticResource AccentButton}"
                                    Command="{Binding ScanGamedataCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Кодировки, узлы, сводка -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc importEncoding}" Style="{StaticResource CaptionText}" />
                        <ListBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding ImportEncoding}"
                                 MaxHeight="108" Margin="0,4,0,14" />

                        <TextBlock Text="{loc:Loc exportEncoding}" Style="{StaticResource CaptionText}" />
                        <ListBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding ExportEncoding}"
                                 MaxHeight="108" Margin="0,4,0,14" />

                        <CheckBox Content="{loc:Loc nodesDisplay}" IsChecked="{Binding ShowNodeText}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Loc total}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Summary.Total}" Style="{StaticResource TitleText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderBevel}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc cancel}" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc ok}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
