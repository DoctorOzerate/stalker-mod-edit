{
  "name": "x-ray-forge",
  "version": "1.0.0",
  "description": "Мастерская моддинга S.T.A.L.K.E.R.: диалоги, персонажи, предметы, иконки, скрипты и локализации.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "vite",
    "electron": "electron .",
    "dist": "vite build && electron-builder --win",
    "test": "node --test test/*.test.mjs",
    "dev": "vite"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "fflate": "^0.8.2",
    "@xmldom/xmldom": "^0.8.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20"
  },
  "build": {
    "appId": "com.xray.forge",
    "productName": "X-Ray Forge",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  }
}
