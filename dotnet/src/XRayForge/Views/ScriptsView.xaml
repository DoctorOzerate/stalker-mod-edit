<UserControl x:Class="XRayForge.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:XRayForge.Localization"
             xmlns:controls="clr-namespace:XRayForge.Controls">
    <!--
      Вкладка «Скрипты» (этап 7.4, порт `ScriptsTab.js`): слева создание/открытие/сканирование,
      поиск с заменой и карточки .script/.lua; справа редактор с подсветкой синтаксиса прямо
      во время ввода, справочник API и сниппеты, проверка Lua, граф вызовов и diff.
    -->
    <UserControl.Resources>
        <!-- Карточка списка (`rounded-xl border p-3 ui.card ui.hover`) -->
        <Style x:Key="ScriptCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="{StaticResource CornerMd}" Padding="8" BorderThickness="1"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderBevel}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource SurfaceSunken}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Акцентная рамка выбранной карточки (поверх шаблона) -->
        <Style x:Key="ScriptSelectedBadge" TargetType="Border">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentMain}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="ScriptCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Карточка списка скриптов: общая для игровых и локационных файлов -->
        <DataTemplate x:Key="ScriptCardTemplate">
            <Button Style="{StaticResource ScriptCardButton}"
                    Command="{Binding SelectCommand}">
                <Border Style="{StaticResource ScriptSelectedBadge}" CornerRadius="{StaticResource CornerMd}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding ChangeMark}"
                                       FontSize="10" Margin="4,0,0,0"
                                       Foreground="{StaticResource StatusWarning}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Subtitle}"
                                   Style="{StaticResource CaptionText}" FontSize="10"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    Margin="0,6,0,0" HorizontalAlignment="Right">
                            <Button Content="{loc:Loc scriptRename}"
                                    Style="{StaticResource ToolbarButton}"
                                    FontSize="10" Padding="6,2" MinHeight="22"
                                    Command="{Binding RenameCommand}" />
                            <Button Content="{loc:Loc scriptDelete}"
                                    Style="{StaticResource ToolbarButton}"
                                    FontSize="10" Padding="6,2" MinHeight="22"
                                    Margin="4,0,0,0"
                                    Foreground="{StaticResource StatusDanger}"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ActiveTab.Glyph}" Margin="0,0,8,0"
                           Foreground="{Binding ActiveTab.AccentHex, Converter={StaticResource HexBrush}}" />
                <TextBlock Text="{Binding ActiveTab.Label}" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding ActiveTab.Hotkey}" Style="{StaticResource CaptionText}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:Loc tabScriptsHint}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ScriptsPaneColumn" Width="288" MinWidth="180" MaxWidth="900" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Левая панель (`aside w-72 border-r p-4 overflow-auto`) -->
            <Border Grid.Column="0" Background="{DynamicResource SurfacePanel}"
                    BorderBrush="{DynamicResource BorderBevel}" BorderThickness="0,1,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <Button Content="{loc:Loc scriptCreate}" Style="{StaticResource AccentButton}"
                                Command="{Binding Scripts.CreateScriptCommand}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{loc:Loc scriptOpen}"
                                    Style="{StaticResource ToolbarButton}"
                                    Command="{Binding Scripts.OpenFileCommand}" Margin="0,0,3,0" />
                            <Button Grid.Column="1" Content="{loc:Loc scriptScan}"
                                    Style="{StaticResource ToolbarButton}"
                                    Command="{Binding Scripts.ScanFilesCommand}" Margin="3,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding Scripts.CountText}" Style="{StaticResource CaptionText}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{loc:Loc scriptSearch}" Style="{StaticResource SideCardTitle}"
                                   Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Scripts.Search, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CompactMonoInput}" />
                            <CheckBox Grid.Column="1" Content="{loc:Loc scriptSortByName}"
                                      IsChecked="{Binding Scripts.SortByName}" Margin="6,0,0,0"
                                      VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{loc:Loc scriptReplaceWith}" Style="{StaticResource FieldLabel}"
                                   Margin="0,8,0,3" />
                        <TextBox Text="{Binding Scripts.ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CompactMonoInput}" />
                        <Button Content="{loc:Loc scriptReplaceAll}" Style="{StaticResource ToolbarButton}"
                                Margin="0,6,0,0" Command="{Binding Scripts.ReplaceAllCommand}" />

                        <Border Background="{DynamicResource SurfaceRaised}" BorderThickness="0"
                                CornerRadius="{StaticResource CornerMd}" Padding="8" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc scriptApi}" Style="{StaticResource SideCardTitle}" />
                                <ComboBox ItemsSource="{Binding Scripts.EngineApi}"
                                          SelectedItem="{Binding Scripts.SelectedApi}"
                                          Style="{StaticResource ScriptCombo}" IsTextSearchEnabled="True" />
                                <Button Content="{loc:Loc scriptInsertApi}"
                                        Style="{StaticResource ToolbarButton}" Margin="0,4,0,0"
                                        Command="{Binding Scripts.InsertApiCommand}"
                                        CommandParameter="{Binding Scripts.SelectedApi}" />
                                <TextBlock Text="{loc:Loc scriptSnippets}"
                                           Style="{StaticResource SideCardTitle}" Margin="0,8,0,0" />
                                <ComboBox ItemsSource="{Binding Scripts.Snippets}"
                                          SelectedItem="{Binding Scripts.SelectedSnippet}"
                                          DisplayMemberPath="Label" Style="{StaticResource ScriptCombo}" />
                                <Button Content="{loc:Loc scriptInsertSnippet}"
                                        Style="{StaticResource ToolbarButton}" Margin="0,4,0,0"
                                        Command="{Binding Scripts.InsertSnippetCommand}" />
                            </StackPanel>
                        </Border>
                        <!-- Списки разделены: игровые скрипты (`gamedata/scripts`) и локационные -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding Scripts.HasGameScripts,
                                        Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc scriptGroupGame}"
                                       Style="{StaticResource SideCardTitle}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Scripts.GameScripts}"
                                          ItemTemplate="{StaticResource ScriptCardTemplate}" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding Scripts.HasLocalScripts,
                                        Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc scriptGroupLocation}"
                                       Style="{StaticResource SideCardTitle}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Scripts.LocalScripts}"
                                          ItemTemplate="{StaticResource ScriptCardTemplate}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Scripts.NoScriptsText}"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding Scripts.HasVisibleScripts,
                                       Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnPaneSplitterDragCompleted" />

            <ScrollViewer Grid.Column="2" x:Name="DetailsScroll"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="16" MinHeight="{Binding ViewportHeight, ElementName=DetailsScroll}">
                    <StackPanel Style="{StaticResource EmptyStateHost}"
                                Visibility="{Binding Scripts.HasSelection,
                                    Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="&#xE943;" Style="{StaticResource EmptyStateGlyph}" />
                        <TextBlock Text="{loc:Loc scriptEditorEmpty}" Style="{StaticResource EmptyStateTitle}" />
                        <TextBlock Text="{loc:Loc scriptEditorEmptyHint}" Style="{StaticResource EmptyStateHint}" />
                    </StackPanel>

                    <!-- Строки: вкладки, шапка, статус, редактор (*), диагностика, граф.
                         Редактор тянется на свободную высоту окна, поэтому при раскрытом
                         окне не остаётся пустого места. -->
                    <Grid DataContext="{Binding Scripts}" MaxWidth="1000"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Visibility="{Binding HasSelection,
                              Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Открытые файлы: полоса вкладок, содержимое — один общий редактор -->
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerMd}" Padding="4" Margin="0,0,0,8"
                                Visibility="{Binding HasOpenScripts,
                                    Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OpenScripts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="7" Margin="0,0,4,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SurfacePanel}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource ToolbarButton}"
                                                            Padding="8,4"
                                                            Command="{Binding SelectCommand}"
                                                            ToolTip="{Binding Subtitle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                                            <TextBlock Text="{Binding ChangeMark}"
                                                                       FontSize="10" Margin="4,0,0,0"
                                                                       Foreground="{StaticResource StatusWarning}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource ToolbarButton}"
                                                            Padding="4,2" Margin="0,0,2,0"
                                                            Command="{Binding CloseCommand}"
                                                            ToolTip="{loc:Loc scriptCloseTab}">
                                                        <TextBlock Text="✕" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Шапка: имя, путь и действия файла -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerMd}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Selected.Name}" FontSize="17"
                                               FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Selected.Subtitle}"
                                               Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" Orientation="Horizontal"
                                           VerticalAlignment="Top">
                                    <Button Content="{loc:Loc scriptDownload}"
                                            Style="{StaticResource ToolbarButton}"
                                            Command="{Binding DownloadCommand}" Margin="0,0,4,4" />
                                    <Button Content="{loc:Loc scriptFormat}"
                                            Style="{StaticResource ToolbarButton}"
                                            Command="{Binding FormatScriptCommand}" Margin="0,0,4,4" />
                                    <Button Content="{loc:Loc scriptDiff}"
                                            Style="{StaticResource ToolbarButton}"
                                            Command="{Binding ToggleDiffCommand}" Margin="0,0,0,4"
                                            IsEnabled="{Binding CanShowDiff}" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Статус проверки: скобки, диагностика и число функций -->
                        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                            <Border Background="{DynamicResource SurfacePanel}" CornerRadius="{StaticResource CornerMd}"
                                    Padding="8,3" Margin="0,0,6,4">
                                <TextBlock Text="{Binding BracketsText}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BracketsBalanced}"
                                                             Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource StatusDanger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Border Background="{DynamicResource SurfacePanel}" CornerRadius="{StaticResource CornerMd}"
                                    Padding="0" Margin="0,0,6,4">
                                <Button Style="{StaticResource ToolbarButton}" Padding="8,3"
                                        Command="{Binding ToggleDiagnosticsCommand}"
                                        IsEnabled="{Binding HasDiagnostics}"
                                        ToolTip="{loc:Loc scriptDiagnosticsToggle}">
                                    <TextBlock Text="{Binding DiagnosticsToggleText}" FontSize="11" />
                                </Button>
                            </Border>
                            <Border Background="{DynamicResource SurfacePanel}" CornerRadius="{StaticResource CornerMd}"
                                    Padding="8,3" Margin="0,0,0,4">
                                <TextBlock Text="{Binding CallGraphTitle}" FontSize="11" />
                            </Border>
                        </WrapPanel>

                        <Grid Grid.Row="3" MinHeight="240">
                            <!-- Редактор (`textarea` + нумерация строк) -->
                            <Border BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                    CornerRadius="{StaticResource CornerMd}" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowDiff}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Background="{DynamicResource SurfaceSunken}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource SurfacePanel}"
                                            BorderBrush="{DynamicResource BorderBevel}"
                                            BorderThickness="0,0,1,0">
                                        <ScrollViewer x:Name="LineNumbersScroll"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Selected.LineNumbers}"
                                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextAlignment="Right" Padding="6,8,6,8" />
                                        </ScrollViewer>
                                    </Border>
                                    <controls:LuaEditor Grid.Column="1" x:Name="EditorBox"
                                                        ToolTip="{loc:Loc scriptLinkHint}"
                                                        EditorText="{Binding Selected.Text,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                        FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="8" MinHeight="240"
                                                        Suggestions="{Binding Completions}"
                                                        CaretBrush="{DynamicResource AccentMain}"
                                                        SelectionBrush="{DynamicResource AccentDim}"
                                                        SelectionChanged="OnEditorSelectionChanged"
                                                        TextChanged="OnEditorTextChanged" />
                                </Grid>
                            </Border>

                            <!-- Сравнение с исходником (`renderScriptDiff`) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowDiff}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderThickness="1" CornerRadius="{StaticResource CornerMd}"
                                        BorderBrush="{DynamicResource BorderBevel}"
                                        Background="{DynamicResource SurfaceSunken}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding SourceCaption}"
                                                   Style="{StaticResource SideCardTitle}"
                                                   Margin="8,6,8,4" />
                                        <TextBox Grid.Row="1" Text="{Binding Selected.Original, Mode=OneWay}"
                                                 IsReadOnly="True" AcceptsReturn="True"
                                                 FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 Padding="8" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" BorderThickness="1" CornerRadius="{StaticResource CornerMd}"
                                        BorderBrush="{DynamicResource BorderBevel}"
                                        Background="{DynamicResource SurfaceSunken}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding CurrentCaption}"
                                                   Style="{StaticResource SideCardTitle}"
                                                   Margin="8,6,8,4" />
                                        <TextBox Grid.Row="1" Text="{Binding Selected.Text, Mode=OneWay}"
                                                 IsReadOnly="True" AcceptsReturn="True"
                                                 FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 Padding="8" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Диагностика Lua (сворачивается кнопкой в шапке или чипом выше) -->
                        <Border Grid.Row="4" Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}"
                                BorderThickness="1" CornerRadius="{StaticResource CornerMd}" Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding ShowDiagnosticsPanel,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DiagnosticsTitle}"
                                               Style="{StaticResource SideCardTitle}" Margin="0" />
                                    <Button Grid.Column="1" Content="{loc:Loc scriptHideDiagnostics}"
                                            Style="{StaticResource ToolbarButton}"
                                            Padding="6,1" Margin="8,0,0,0"
                                            Command="{Binding ToggleDiagnosticsCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,1">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource StatusWarning}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource StatusDanger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- Функции и граф вызовов -->
                        <Border Grid.Row="5" Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}"
                                BorderThickness="1" CornerRadius="{StaticResource CornerMd}" Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding HasCallGraph,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding CallGraphTitle}"
                                           Style="{StaticResource SideCardTitle}" />
                                <ItemsControl ItemsSource="{Binding Functions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Text}"
                                                    ToolTip="{Binding Tooltip}"
                                                    Style="{StaticResource ToolbarButton}"
                                                    FontSize="10" Padding="6,2" Margin="0,0,4,4"
                                                    Command="{Binding DataContext.Scripts.JumpFunctionCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding UnusedText}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                <ItemsControl ItemsSource="{Binding Edges}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       Style="{StaticResource MonoText}"
                                                       FontSize="11" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
