<Window x:Class="XRayForge.Views.SelfCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:XRayForge.Localization"
        Title="{loc:Loc selfCheck}"
        Width="660" Height="580" MinWidth="500" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderBevel}" BorderThickness="0,0,0,1"
                    Padding="12,6" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <TextBlock Text="{loc:Loc selfCheck}" Style="{StaticResource TitleText}"
                               VerticalAlignment="Center" />
                    <Button Content="✕" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right" IsCancel="True" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,12,16,6">
                <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="{loc:Loc selfCheckHint}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,0,16,8">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource StateOk}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource StateDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource SurfacePanel}"
                    BorderBrush="{DynamicResource BorderBevel}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Button Content="{loc:Loc done}" Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
            </Border>
        </Grid>
    </Border>
</Window>
