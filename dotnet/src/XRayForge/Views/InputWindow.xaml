<Window x:Class="XRayForge.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:XRayForge.Localization"
        Title="{Binding Caption}"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBase}">
    <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <StackPanel>
            <!-- Заголовок окна: перетаскивание + закрытие -->
            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderBevel}"
                    BorderThickness="0,0,0,1" Padding="12,6" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            IsCancel="True" ToolTip="{loc:Loc close}" />
                </Grid>
            </Border>

            <StackPanel Margin="14">
                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                <TextBox x:Name="Input" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderBevel}"
                    BorderThickness="0,1,0,0" Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc cancel}" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc ok}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
