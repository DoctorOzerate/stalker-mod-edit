<Window x:Class="XRayForge.Views.EquipSlotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:XRayForge.Localization"
        Title="{loc:Loc itemSlotEditorTitle}"
        Width="1060" Height="700" MinWidth="780" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBase}">
    <Window.Resources>
        <!-- Нередактируемый предпросмотр слота: геометрия задаётся полями справа. -->
        <DataTemplate x:Key="SlotPreviewTemplate">
            <Border Background="{DynamicResource SurfaceSunken}"
                    BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                    CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Icon}" Stretch="Uniform" Margin="6"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon,
                               Converter={StaticResource BoolToVisibility}}" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="3" Padding="3,1" CornerRadius="2"
                            Background="{DynamicResource SurfacePanel}" Opacity="0.92">
                        <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource TextAccent}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Margin="3" Padding="3,1" CornerRadius="2"
                            Background="{DynamicResource SurfacePanel}" Opacity="0.92">
                        <TextBlock Text="{Binding DisplayName}" FontSize="9"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource SurfacePanel}"
            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок: перетаскивание + закрытие -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderBevel}" BorderThickness="0,0,0,1"
                    Padding="12,6" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc itemSlotEditorTitle}"
                                   Style="{StaticResource TitleText}" />
                        <TextBlock Text="{loc:Loc itemSlotEditorHint}"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsCancel="True" ToolTip="{loc:Loc close}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Общий прямоугольник раскладки: то же поле, что и на вкладке «Предметы» -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceSunken}"
                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                        CornerRadius="6" Padding="6">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding EquipSlots}"
                                      Width="{Binding SlotCanvasWidth}"
                                      Height="{Binding SlotCanvasHeight}"
                                      ItemTemplate="{StaticResource SlotPreviewTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding SlotCanvasWidth}"
                                            Height="{Binding SlotCanvasHeight}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    <Setter Property="Width" Value="{Binding Width}" />
                                    <Setter Property="Height" Value="{Binding Height}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Viewbox>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding EquipSlots}"
                             SelectedItem="{Binding SelectedEquipSlot}"
                             BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                             Background="{DynamicResource SurfaceSunken}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10">
                        <Button Content="{loc:Loc itemSlotAdd}" Style="{StaticResource AccentButton}"
                                Command="{Binding AddEquipSlotCommand}" Margin="0,0,6,0" />
                        <Button Content="{loc:Loc itemSlotDelete}"
                                Command="{Binding RemoveEquipSlotCommand}" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}"
                            BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                            CornerRadius="8" Padding="10"
                            IsEnabled="{Binding HasSelectedEquipSlot}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc itemSlotLabel}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,4,0,8"
                                     Text="{Binding SelectedEquipSlot.Label,
                                         UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc itemSlotKey}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,4,0,8"
                                     IsReadOnly="True" Text="{Binding SelectedEquipSlot.Key, Mode=OneWay}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc itemSlotX}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,8"
                                     Text="{Binding SelectedEquipSlot.X, UpdateSourceTrigger=LostFocus,
                                         StringFormat=F0}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{loc:Loc itemSlotY}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="4" Margin="0,4,0,8"
                                     Text="{Binding SelectedEquipSlot.Y, UpdateSourceTrigger=LostFocus,
                                         StringFormat=F0}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc itemSlotWidth}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                                     Text="{Binding SelectedEquipSlot.Width, UpdateSourceTrigger=LostFocus,
                                         StringFormat=F0}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{loc:Loc itemSlotHeight}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="4" Margin="0,4,0,0"
                                     Text="{Binding SelectedEquipSlot.Height, UpdateSourceTrigger=LostFocus,
                                         StringFormat=F0}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource SurfacePanel}"
                    BorderBrush="{DynamicResource BorderBevel}" BorderThickness="0,1,0,0"
                    Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc cancel}" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc ok}" Style="{StaticResource AccentButton}"
                            IsDefault="True" Click="OnOk" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
