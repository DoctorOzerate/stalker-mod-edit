<Application x:Class="XRayForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XRayForge.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Токены, шрифты и стили каркаса: ThemeService перезаписывает токены в рантайме -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Fonts.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:HexBrushConverter x:Key="HexBrush" />
            <conv:LocalizationKeyConverter x:Key="LocKey" />
            <conv:PathDataConverter x:Key="EdgeGeometry" />
            <conv:NonEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
