<UserControl x:Class="XRayForge.Views.LanguagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:XRayForge.Localization">
    <!--
      Вкладка «Языки» (этап 7.6, порт LanguagesTab.js): сводная таблица locale-колонок,
      редактор string_table по языкам, импорт XML, проверка text_id и покрытие реплик.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="LangRed" Color="#F87171" />
        <SolidColorBrush x:Key="LangAmber" Color="#FBBF24" />
        <SolidColorBrush x:Key="LangGreen" Color="#4ADE80" />
        <Style x:Key="LangCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="LangTitle" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="LangLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="LangEntryBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc tabLanguages}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc tabLanguagesHint}" Style="{StaticResource CaptionText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Languages.StatsText}" Style="{StaticResource CaptionText}"
                           Margin="0,3,0,0" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="{Binding Languages.ModeText}"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding Languages.ToggleSummaryCommand}" Margin="0,0,4,0" />
                <Button Content="{loc:Loc languagesImport}"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding Languages.ImportXmlCommand}" Margin="0,0,4,0" />
                <Button Content="{loc:Loc languagesTableCreated}"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding Languages.AddTableCommand}" />
            </WrapPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,16" MaxWidth="1200" HorizontalAlignment="Stretch">
                <!-- Проверка text_id -->
                <Border Style="{StaticResource LangCard}"
                        Visibility="{Binding Languages.HasIssues,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Languages.IssuesTitle}" Style="{StaticResource LangTitle}"
                                   Foreground="{StaticResource LangRed}" />
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Languages.Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontSize="11"
                                                   TextWrapping="Wrap" Padding="0,1"
                                                   Foreground="{StaticResource LangAmber}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Сводная таблица -->
                <Border Style="{StaticResource LangCard}"
                        Visibility="{Binding Languages.SummaryMode,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc languagesSummary}" Style="{StaticResource LangTitle}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{loc:Loc languagesId}" Width="220" FontSize="11"
                                               FontWeight="Bold" />
                                    <ItemsControl ItemsSource="{Binding Languages.Languages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Locale}" Width="180"
                                                           FontSize="11" FontWeight="Bold" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc languagesNoRows}" Style="{StaticResource CaptionText}"
                                           Visibility="{Binding Languages.HasSummaryRows,
                                               Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Languages.SummaryRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Text="{Binding Id}" Width="220" FontSize="11"
                                                           FontFamily="Consolas" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="180" Margin="0,0,4,0" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource BorderBevel}">
                                                                <TextBox Style="{StaticResource LangEntryBox}"
                                                                         Text="{Binding Text, Mode=TwoWay,
                                                                             UpdateSourceTrigger=PropertyChanged}"
                                                                         BorderThickness="0" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>


                <!-- Редактор по языкам -->
                <StackPanel Visibility="{Binding Languages.SummaryMode,
                    Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{loc:Loc languagesEmpty}" Style="{StaticResource CaptionText}"
                               Visibility="{Binding Languages.HasLanguages,
                                   Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Languages.Languages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LangCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding LocaleLabel}"
                                                           Style="{StaticResource LangLabel}" />
                                                <TextBox Style="{StaticResource LangEntryBox}"
                                                         Text="{Binding Locale, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding NameLabel}"
                                                           Style="{StaticResource LangLabel}" />
                                                <TextBox Style="{StaticResource LangEntryBox}"
                                                         Text="{Binding Name, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Bottom" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding CountText}"
                                                           Style="{StaticResource CaptionText}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Content="{Binding DeleteText}"
                                                        Style="{StaticResource ToolbarButton}"
                                                        Foreground="{StaticResource LangRed}"
                                                        Command="{Binding DeleteTableCommand}" />
                                            </StackPanel>
                                        </Grid>


                                        <ItemsControl ItemsSource="{Binding Entries}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Margin="0,0,4,0"
                                                                BorderThickness="1" ToolTip="{Binding ToolTip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush"
                                                                            Value="{DynamicResource BorderBevel}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDuplicate}"
                                                                                     Value="True">
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="{StaticResource LangRed}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBox Style="{StaticResource LangEntryBox}"
                                                                     Text="{Binding Id, Mode=TwoWay,
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" />
                                                        </Border>
                                                        <Border Grid.Column="1" Margin="0,0,4,0"
                                                                BorderThickness="1" ToolTip="{Binding ToolTip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush"
                                                                            Value="{DynamicResource BorderBevel}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEmpty}"
                                                                                     Value="True">
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="{StaticResource LangAmber}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBox Style="{StaticResource LangEntryBox}"
                                                                     Text="{Binding Text, Mode=TwoWay,
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" />
                                                        </Border>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding UsageText}"
                                                                       Style="{StaticResource CaptionText}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       Visibility="{Binding HasUsage,
                                                                           Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Content="✕"
                                                                    Style="{StaticResource ToolbarButton}"
                                                                    Foreground="{StaticResource LangRed}"
                                                                    Padding="6,0" MinHeight="24"
                                                                    Command="{Binding RemoveCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding AddEntryText}"
                                                Style="{StaticResource ToolbarButton}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Command="{Binding AddEntryCommand}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

