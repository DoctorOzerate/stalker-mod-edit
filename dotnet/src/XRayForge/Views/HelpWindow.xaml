<Window x:Class="XRayForge.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:XRayForge.Localization"
        Title="{loc:Loc helpTitle}"
        Width="620" Height="560" MinWidth="480" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderBevel}"
                    BorderThickness="0,0,0,1" Padding="12,6" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <TextBlock Text="{loc:Loc helpTitle}" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" IsCancel="True" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc helpProjectsTitle}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc helpProjectsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,14" />

                    <TextBlock Text="{loc:Loc helpTabsTitle}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc helpTabsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,14" />

                    <TextBlock Text="{loc:Loc helpHotkeysTitle}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc helpHotkeysText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,14" />

                    <TextBlock Text="{loc:Loc helpGamedataTitle}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc helpGamedataText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,14" />

                    <TextBlock Text="{loc:Loc helpThemeTitle}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc helpThemeText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderBevel}"
                    BorderThickness="0,1,0,0" Padding="12,10">
                <Button Content="{loc:Loc done}" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                        IsDefault="True" IsCancel="True" />
            </Border>
        </Grid>
    </Border>
</Window>
