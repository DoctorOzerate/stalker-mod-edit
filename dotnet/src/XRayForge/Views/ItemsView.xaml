<UserControl x:Class="XRayForge.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:XRayForge.Localization"
             xmlns:controls="clr-namespace:XRayForge.Controls">
    <!--
      Вкладка «Предметы» (этап 7.2, порт `ItemsTab.js`): слева создание/экспорт, массовые
      операции, фильтр по категории, поиск, сортировка и группы секций; справа редактор
      с наследованием, атласом, быстрыми полями, деревом, ссылками и слотами экипировки.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="ItemRed" Color="#F87171" />
        <SolidColorBrush x:Key="ItemGreen" Color="#4ADE80" />
        <SolidColorBrush x:Key="ItemAmber" Color="#FBBF24" />

        <!-- Подпись поля (`text-xs font-mono`) -->
        <Style x:Key="ItemLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- Заголовок карточки (`text-[10px] uppercase tracking-widest font-bold`) -->
        <Style x:Key="ItemCardTitle" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Карточка списка (`rounded-xl border p-3 ui.card ui.hover`), выбранная — акцентом -->
        <Style x:Key="ItemCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="10" Padding="8" BorderThickness="1"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderBevel}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource SurfaceSunken}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource AccentMain}" />
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource AccentDim}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вторая строка карточки (`text-[10px]`) -->
        <Style x:Key="ItemCardSubtitle" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <!-- Выпадающий список в тёмной теме -->
        <Style x:Key="ItemComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SurfacePanel}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource AccentDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ItemCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBevel}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ItemComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Selection" Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  IsHitTestVisible="False" />
                                <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock Text="▾" FontSize="10" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource SurfacePanel}"
                                        BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush"
                                        Value="{DynamicResource AccentMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Поле значения: наследуемые/закрытые значения только для чтения, ошибка — красным -->
        <Style x:Key="ItemFieldInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditable}" Value="False">
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="Opacity" Value="0.62" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ItemRed}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ItemAmber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Компактная кнопка действия в строке поля (`btn text-[11px]`) -->
        <Style x:Key="ItemFieldAction" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="22" />
        </Style>

        <!-- Чип быстрого поля: `bg-green-500/20 text-green-600` при наличии поля -->
        <Style x:Key="ItemChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPresent}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ItemGreen}" />
                    <Setter Property="Background" Value="#204ADE80" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Узел дерева наследования (`text-[11px] font-mono`), текущий — акцент -->
        <Style x:Key="ItemTreeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAccent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentMain}" />
                    <Setter Property="Background" Value="{DynamicResource AccentDim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопка родительской секции: отсутствующая — красная и недоступная -->
        <Style x:Key="ItemParentButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource ItemRed}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!-- Ячейка атласа 16×16: фоновая картинка ячейки и акцентная рамка текущей -->
        <Style x:Key="ItemAtlasCell" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cell" BorderThickness="1" Background="{DynamicResource SurfaceSunken}"
                                BorderBrush="{DynamicResource BorderBevel}" SnapsToDevicePixels="True">
                            <Image Source="{Binding Image}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush"
                                        Value="{StaticResource ItemGreen}" />
                                <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка слота экипировки (`rounded-xl border p-3`) -->
        <Style x:Key="ItemSlotButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="16,14,16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ActiveTab.Glyph}" Margin="0,0,8,0"
                           Foreground="{Binding ActiveTab.AccentHex, Converter={StaticResource HexBrush}}" />
                <TextBlock Text="{Binding ActiveTab.Label}" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding ActiveTab.Hotkey}" Style="{StaticResource CaptionText}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:Loc tabItemsHint}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левая панель (`aside w-72 border-r p-4 overflow-auto`) -->
            <Border Grid.Column="0" Background="{DynamicResource SurfacePanel}"
                    BorderBrush="{DynamicResource BorderBevel}" BorderThickness="0,1,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <Button Content="{loc:Loc itemCreate}" Style="{StaticResource AccentButton}"
                                Command="{Binding Items.CreateCommand}" />
                        <TextBlock Text="{Binding Items.CountText}" Style="{StaticResource CaptionText}"
                                   Margin="0,8,0,0" />

                        <Button Content="{loc:Loc itemExportLtx}" Style="{StaticResource ToolbarButton}"
                                Margin="0,8,0,0" Command="{Binding Items.ExportLtxCommand}" />
                        <Button Content="{loc:Loc itemExportCsv}" Style="{StaticResource ToolbarButton}"
                                Margin="0,6,0,0" Command="{Binding Items.ExportCsvCommand}" />

                        <TextBlock Text="{loc:Loc itemMassEdit}" Style="{StaticResource ItemCardTitle}"
                                   Margin="0,12,0,4" />
                        <Button Content="{loc:Loc itemRename}" Style="{StaticResource ToolbarButton}"
                                Command="{Binding Items.RenameCommand}" />
                        <Button Content="{loc:Loc itemReplace}" Style="{StaticResource ToolbarButton}"
                                Margin="0,6,0,0" Command="{Binding Items.ReplaceFieldValuesCommand}" />

                        <ComboBox ItemsSource="{Binding Items.CategoryOptions}"
                                  SelectedItem="{Binding Items.CategoryFilter}"
                                  Style="{StaticResource ItemCombo}" Height="28" Margin="0,12,0,0"
                                  ToolTip="{loc:Loc itemCategoryHint}" />
                        <Grid Margin="0,8,0,0">
                            <TextBox Text="{Binding Items.Search, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Loc itemSearchHint}" />
                            <TextBlock Text="{loc:Loc itemSearch}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="9,0"
                                       Foreground="{DynamicResource TextMuted}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox SelectedValue="{Binding Items.SortMode}" Height="28"
                                  Style="{StaticResource ItemCombo}"
                                  VerticalContentAlignment="Center"
                                  SelectedValuePath="Tag" Margin="0,8,0,0"
                                  ToolTip="{loc:Loc itemSortHint}">
                            <ComboBoxItem Content="{loc:Loc itemSortName}" Tag="name" />
                            <ComboBoxItem Content="{loc:Loc itemSortCount}" Tag="count" />
                        </ComboBox>

                        <ItemsControl ItemsSource="{Binding Items.Groups}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource ItemCardTitle}"
                                                   Margin="0,6,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ItemCardButton}"
                                                            AutomationProperties.Name="{Binding Name}"
                                                            Command="{Binding SelectCommand}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       Style="{StaticResource ItemCardSubtitle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Items.NoGroupsText}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Items.HasGroups,
                                       Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Правая панель: редактор выбранной секции (`max-w-3xl`) -->
            <ScrollViewer Grid.Column="1" x:Name="DetailsScroll"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="16">
                    <TextBlock Text="{loc:Loc itemEditorEmpty}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Top"
                               Visibility="{Binding Items.HasSelection,
                                   Converter={StaticResource InverseBoolToVisibility}}" />

                    <StackPanel DataContext="{Binding Items}" MaxWidth="820" HorizontalAlignment="Left"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <!-- Шапка редактора: имя, категория и действия секции -->
                        <Border Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Selected.Name}" FontSize="17"
                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <Border Background="{DynamicResource AccentDim}" CornerRadius="8"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Selected.Category}" FontSize="10"
                                                       Foreground="{DynamicResource AccentMain}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Selected.Subtitle}"
                                               Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="{loc:Loc itemUndo}" Style="{StaticResource ToolbarButton}"
                                            Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                                            Margin="0,0,4,0" />
                                    <Button Content="{loc:Loc itemRedo}" Style="{StaticResource ToolbarButton}"
                                            Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                                            Margin="0,0,4,0" />
                                    <Button Content="{loc:Loc itemAddField}" Style="{StaticResource ToolbarButton}"
                                            Command="{Binding AddFieldCommand}" Margin="0,0,4,0" />
                                    <Button Content="{loc:Loc itemDelete}" Style="{StaticResource ToolbarButton}"
                                            Command="{Binding DeleteCommand}"
                                            Foreground="{StaticResource ItemRed}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Наследование: сводка, кнопки родителей и отсутствующие родители -->
                        <Border Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc itemInheritsFrom}"
                                           Style="{StaticResource ItemCardTitle}" />
                                <TextBlock Text="{Binding InheritanceSummary}" FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMuted}" />
                                <ItemsControl ItemsSource="{Binding ParentLinks}" Margin="0,6,0,0"
                                              Visibility="{Binding HasParents,
                                                  Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Style="{StaticResource ItemParentButton}"
                                                    Command="{Binding SelectCommand}"
                                                    ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding BrokenParentsText}" FontSize="11"
                                           Foreground="{StaticResource ItemRed}" TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasBrokenParents,
                                               Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                        <!-- Иконка предмета: превью, кнопка выбора и раскрываемая сетка атласа -->
                        <Border Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding HasAtlas,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="88" Height="88" CornerRadius="6"
                                            Background="{DynamicResource SurfaceSunken}"
                                            BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding SelectedItemIcon}" Stretch="Uniform"
                                                   Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{loc:Loc itemIconEmpty}"
                                                       Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap" Margin="4"
                                                       Visibility="{Binding HasSelectedItemIcon,
                                                           Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc itemIcon}" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="{Binding AtlasTitle}" Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding GridCoordsText}" FontFamily="Consolas"
                                                   FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource AccentMain}" />
                                        <TextBlock Text="{loc:Loc itemIconHint}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{loc:Loc itemIconChoose}"
                                            Style="{StaticResource ToolbarButton}"
                                            Command="{Binding ToggleIconPickerCommand}"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <Border Background="{DynamicResource SurfaceSunken}"
                                        BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                        CornerRadius="8" Padding="8" Margin="0,8,0,0"
                                        Visibility="{Binding IsIconPickerOpen,
                                            Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc itemIconPicker}"
                                                   Style="{StaticResource ItemCardTitle}" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                            <ItemsControl ItemsSource="{Binding AtlasCells}" HorizontalAlignment="Left">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="{Binding AtlasColumns}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ItemAtlasCell}"
                                                                Command="{Binding PickCommand}"
                                                                ToolTip="{Binding Tooltip}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- Защита корневой секции: предупреждение и разблокировка -->
                        <Border Background="#18FBBF24" BorderBrush="{StaticResource ItemAmber}"
                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding IsLocked,
                                    Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc itemLockedRoot}"
                                           FontSize="11" Foreground="{StaticResource ItemAmber}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="{loc:Loc itemUnlockSection}"
                                        Style="{StaticResource ToolbarButton}"
                                        Command="{Binding UnlockRootCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Быстрые поля выбранной категории: чип добавляет отсутствующее поле -->
                        <Border Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding HasQuickFields,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding QuickFieldsTitle}"
                                           Style="{StaticResource ItemCardTitle}" />
                                <ItemsControl ItemsSource="{Binding QuickFields}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ItemChipButton}"
                                                    Content="{Binding Text}"
                                                    Command="{Binding AddCommand}"
                                                    ToolTip="{Binding Tooltip}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- Поля секции: собственные и унаследованные, правка значения на месте -->
                        <Border Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FieldsCaption}"
                                               Style="{StaticResource ItemCardTitle}" Margin="0" />
                                    <Button Grid.Column="1" Content="{loc:Loc itemAddField}"
                                            Style="{StaticResource ItemFieldAction}"
                                            Command="{Binding AddFieldCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="164" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           ToolTip="{Binding Tooltip}" FontFamily="Consolas"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Margin="0,0,6,0" TextTrimming="CharacterEllipsis" />
                                                <controls:SuggestionTextBox Grid.Column="1"
                                                         Style="{StaticResource ItemFieldInput}"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         Suggestions="{Binding Suggestions}"
                                                         TokenSeparators=",;"
                                                         ToolTip="{Binding Tooltip}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Button Content="{loc:Loc itemUnlockFieldAction}"
                                                            Style="{StaticResource ItemFieldAction}"
                                                            Command="{Binding DataContext.UnlockFieldCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanUnlock,
                                                                Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="✕" Style="{StaticResource ItemFieldAction}"
                                                            ToolTip="{loc:Loc itemRemoveField}"
                                                            Command="{Binding DataContext.RemoveFieldCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanRemove,
                                                                Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="🔒" FontSize="11" Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{loc:Loc itemLockedRoot}"
                                                               Visibility="{Binding ShowLock,
                                                                   Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- Дерево наследования: цепочка предков и вложенные дочерние секции -->
                        <Border Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding HasTree,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding TreeTitle}" Style="{StaticResource ItemCardTitle}" />
                                <ItemsControl ItemsSource="{Binding TreeRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ItemTreeButton}"
                                                    Margin="{Binding Margin}"
                                                    Command="{Binding SelectCommand}"
                                                    ToolTip="{Binding Name}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" Margin="0,0,4,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                    <TextBlock Text="{Binding Text}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- Ссылки: секции, которые ссылаются на текущую -->
                        <Border Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding ReferencesTitle}"
                                           Style="{StaticResource ItemCardTitle}" />
                                <ItemsControl ItemsSource="{Binding References}"
                                              Visibility="{Binding HasReferences,
                                                  Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Style="{StaticResource ItemParentButton}"
                                                    Command="{Binding SelectCommand}"
                                                    ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Loc itemNoReferences}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Visibility="{Binding HasReferences,
                                               Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                        <!-- Слоты экипировки ЗП: назначить текущую секцию в weapon/armor/helmet -->
                        <Border Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderBevel}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding HasEquipSlots,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding EquipCaption}"
                                           Style="{StaticResource ItemCardTitle}" />
                                <ItemsControl ItemsSource="{Binding EquipSlots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ItemSlotButton}"
                                                    Command="{Binding AssignCommand}"
                                                    ToolTip="{Binding Name}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="38" Height="38"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource SurfaceSunken}"
                                                            BorderBrush="{DynamicResource BorderBevel}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                                                   Margin="2"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding HasIcon,
                                                                       Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="—" FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       Visibility="{Binding HasIcon,
                                                                           Converter={StaticResource InverseBoolToVisibility}}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   FontSize="10" />
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
